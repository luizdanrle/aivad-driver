# GEMINI_API_KEY: Opcional em desenvolvimento/preview (fallback determinístico local ativo).
# Injetada automaticamente pelo Google AI Studio apenas no servidor Express (nunca exposta no cliente).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL do serviço alojado (injetada automaticamente pelo Google AI Studio / Cloud Run).
APP_URL="MY_APP_URL"

# ==============================================================================
# VARIÁVEIS OPCIONAIS EM DESENVOLVIMENTO E PREVIEW (OBRIGATÓRIAS APENAS EM PRODUÇÃO REAL)
# Comentadas por omissão para nunca bloquear o arranque do Preview sem credenciais externas.
# ==============================================================================

# AIVAD_ENV: Define explicitamente o ambiente ('development' | 'test' | 'preview' | 'production').
# Em 'production' dedicado, exige AIVAD_SESSION_SECRET forte (>= 32 caracteres aleatórios, fail-closed).
# AIVAD_ENV="development"

# AIVAD_SESSION_SECRET: Segredo criptográfico HMAC-SHA256 (>= 32 caracteres) para sessões no servidor.
# Em development/test/preview sem esta variável, é gerada uma chave efémera segura de 256 bits por processo.
# AIVAD_SESSION_SECRET=""

# AIVAD_ALLOW_DEMO_SANDBOX: Controla se sessões de demonstração administrativa isoladas são permitidas em produção.
# Por omissão "false" em produção real; não é necessária para arrancar em desenvolvimento ou Preview.
# AIVAD_ALLOW_DEMO_SANDBOX="false"

# Credenciais administrativas opcionais no servidor Express:
# AIVAD_ADMIN_EMAIL=""
# AIVAD_ADMIN_PASSWORD=""

# Conectores externos opcionais Uber / Bolt (Server-Side OAuth Vault — nunca expostos no frontend).
# Quando ausentes, apenas o conector OAuth correspondente fica no estado "Não configurado",
# mantendo toda a aplicação, importação CSV/JSON e captura assistida 100% operacionais:
# UBER_CLIENT_ID=""
# UBER_CLIENT_SECRET=""
# BOLT_CLIENT_ID=""
# BOLT_CLIENT_SECRET=""
